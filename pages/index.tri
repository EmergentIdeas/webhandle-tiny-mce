<!DOCTYPE html>
<html>

<head>
	__externalResourceManager.render()__


</head>

<body>

	__externalResourceManager::@webhandle/tiny-mce/renderExternalResources__
	<div id="editor" style="height: 500px; border: solid 1px black;">

	</div>
	<br>
	<br>
	<br>
	<br>
	<br>
	<textarea class="html-editor"></textarea>
	<textarea name="normal">normal text editor</textarea>

	<br>
	<br>
	<br>
	<br>
	<button id="convert">convert</button>
	<div class="edit-content-inline" style="height: 500px; border: solid 1px black;">
		<p>hello</p>

	</div>
	<script type="module">
		import makeEditor from "@webhandle/tiny-mce"
		makeEditor(document.querySelector('#editor'), "default", {
			inline: true
		})

		let convert = document.querySelector('#convert')
		convert.addEventListener('click', (evt) => {
			makeEditor('.edit-content-inline')
		})
	</script>


	__::@webhandle/tiny-mce/convertTextAreas__


	__externalResourceManager.render()__
</body>


</html>